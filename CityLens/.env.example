# 黑马点评 Java 服务地址（不是 Nginx /api 地址）
DIANPING_BASE_URL=http://127.0.0.1:8081
# 点评前端地址，用于生成可点击的店铺链接
DIANPING_WEB_URL=http://127.0.0.1:18080
# 持久化 SQLite 文件；默认 CityLens/data/citylens.sqlite3。停服务后连同 WAL 文件备份。
CITYLENS_DATA_PATH=
# 可选：anthropic/openai/gemini/deepseek/qwen/kimi/zhipu/openai-compatible
# 不设置 Key 时使用本地规则。配置 Key 时必须填写模型 ID。
CITYLENS_LLM_PROVIDER=anthropic
CITYLENS_LLM_MODEL=
CITYLENS_LLM_API_KEY=
# 留空使用所选供应商的默认 API 地址；自定义兼容服务必须填写。
CITYLENS_LLM_BASE_URL=
CITYLENS_LLM_TIMEOUT=12
# 也可使用供应商标准变量，如 ANTHROPIC_API_KEY、OPENAI_API_KEY、GEMINI_API_KEY、
# DEEPSEEK_API_KEY、DASHSCOPE_API_KEY、MOONSHOT_API_KEY、ZHIPU_API_KEY。

# 本地演示商品管理账号（Java 需配置相同白名单；默认无权限）
CITYLENS_CATALOG_ADMIN_IDS=

# Optional Langfuse Cloud tracing (project keys, not the model provider key).
CITYLENS_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
