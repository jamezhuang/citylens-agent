# Copy these settings into the experiment CityLens/.env, never the stable .env.
CITYLENS_LLM_PROVIDER=deepseek
# Existing project model name; replace if your account uses a different model ID.
CITYLENS_LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
CITYLENS_LLM_BASE_URL=https://api.deepseek.com
CITYLENS_LLM_TIMEOUT=12
